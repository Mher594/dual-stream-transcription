# Copy to .env and fill in real values. Never commit .env.

# Deepgram streaming STT (https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# Desktop WebSocket listen port (extension connects to ws://127.0.0.1:$KRISP_WS_PORT)
KRISP_WS_PORT=8765

# Deepgram model. Optional — defaults to nova-2. Handy for comparing accuracy
# (e.g. nova-3) without rebuilding. The desktop logs the model it connects with.
KRISP_STT_MODEL=nova-2
